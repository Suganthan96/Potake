SUBSTRATE_WS=wss://test-node-v3.portaldot.dev
EVM_RPC=https://test-evm-rpc-v3.portaldot.dev
CHAIN_ID=420420777

# EVM secp256k1 private key (test account only — never commit)
DEPLOYER_PRIVATE_KEY=
# Same key or a separate key allowed to call oracle.publish()
RELAYER_PRIVATE_KEY=
# Substrate seed phrase or JSON keystore path for the staking/agent account
AGENT_SEED=

# Filled in after deploying
ORACLE_ADDRESS=
REGISTRY_ADDRESS=

# Comma-separated SS58 addresses the agent may manage (e.g. 5EjtabLnbcc1EDhnC7Du7QPJEwicdRLXe4o4BGH4Z4vD8W4y)
MANAGED_ACCOUNTS=

# GatedVault min uptime threshold in bps (9500 = 95%)
VAULT_MIN_UPTIME_BPS=9500
