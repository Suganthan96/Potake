<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Potake Deploy</title>
<style>
  :root { --bg:#0f1117; --card:#1a1d27; --border:#2a2d3a; --accent:#7c3aed; --green:#22c55e; --red:#ef4444; --yellow:#f59e0b; --text:#e2e8f0; --muted:#6b7280; }
  * { box-sizing:border-box; margin:0; padding:0; }
  body { background:var(--bg); color:var(--text); font-family:'SF Mono',monospace; font-size:13px; min-height:100vh; padding:24px 16px; }
  h1 { font-size:18px; font-weight:700; color:#fff; margin-bottom:4px; }
  .subtitle { color:var(--muted); margin-bottom:24px; font-size:12px; }
  .card { background:var(--card); border:1px solid var(--border); border-radius:10px; padding:20px; margin-bottom:16px; }
  .card h2 { font-size:13px; font-weight:600; color:var(--accent); margin-bottom:12px; text-transform:uppercase; letter-spacing:.05em; }
  .step { display:flex; align-items:flex-start; gap:12px; padding:10px 0; border-bottom:1px solid var(--border); }
  .step:last-child { border-bottom:none; }
  .badge { min-width:24px; height:24px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; flex-shrink:0; }
  .badge.pending { background:#2a2d3a; color:var(--muted); }
  .badge.running { background:#1d4ed8; color:#fff; }
  .badge.done    { background:var(--green); color:#fff; }
  .badge.error   { background:var(--red); color:#fff; }
  .step-info { flex:1; }
  .step-name { font-weight:600; color:#fff; margin-bottom:3px; }
  .step-detail { color:var(--muted); font-size:11px; word-break:break-all; }
  .step-detail.addr { color:var(--green); }
  .step-detail.err  { color:var(--red); }
  .log { background:#0a0c10; border:1px solid var(--border); border-radius:8px; padding:12px; height:180px; overflow-y:auto; font-size:11px; line-height:1.6; }
  .log .ok   { color:var(--green); }
  .log .warn { color:var(--yellow); }
  .log .err  { color:var(--red); }
  .log .info { color:#60a5fa; }
  .log .dim  { color:var(--muted); }
  button { background:var(--accent); color:#fff; border:none; border-radius:8px; padding:12px 24px; font-size:13px; font-weight:600; cursor:pointer; width:100%; margin-top:12px; transition:.15s; }
  button:hover:not(:disabled) { background:#6d28d9; }
  button:disabled { opacity:.4; cursor:not-allowed; }
  .result-box { background:#0a0c10; border:1px solid var(--green); border-radius:8px; padding:16px; margin-top:12px; display:none; }
  .result-box h3 { color:var(--green); margin-bottom:10px; font-size:13px; }
  .addr-row { display:flex; justify-content:space-between; align-items:center; padding:6px 0; border-bottom:1px solid var(--border); font-size:11px; }
  .addr-row:last-child { border-bottom:none; }
  .addr-label { color:var(--muted); }
  .addr-val   { color:var(--green); font-weight:600; }
  .copy-btn { background:#2a2d3a; border:none; color:var(--muted); padding:3px 8px; border-radius:4px; cursor:pointer; font-size:10px; }
  .copy-btn:hover { color:#fff; }
  .env-block { background:#0a0c10; border-radius:6px; padding:12px; font-size:10px; color:#a3e635; line-height:1.8; margin-top:10px; white-space:pre; }
  select { background:var(--card); color:var(--text); border:1px solid var(--border); border-radius:6px; padding:8px 12px; font-size:12px; width:100%; margin-bottom:8px; }
</style>
</head>
<body>
<h1>Potake Contract Deployer</h1>
<p class="subtitle">Deploys StakingOracle → PolicyRegistry → GatedVault to Portaldot V3 via browser wallet</p>

<div class="card">
  <h2>1. Connect Wallet</h2>
  <select id="accountSelect"><option value="">-- Connect wallet first --</option></select>
  <button id="connectBtn" onclick="connectWallet()">Connect Polkadot Wallet</button>
</div>

<div class="card">
  <h2>2. Deploy Contracts</h2>
  <div id="steps">
    <div class="step" id="s0"><span class="badge pending" id="b0">1</span><div class="step-info"><div class="step-name">StakingOracle</div><div class="step-detail" id="d0">Waiting…</div></div></div>
    <div class="step" id="s1"><span class="badge pending" id="b1">2</span><div class="step-info"><div class="step-name">PolicyRegistry</div><div class="step-detail" id="d1">Waiting…</div></div></div>
    <div class="step" id="s2"><span class="badge pending" id="b2">3</span><div class="step-info"><div class="step-name">GatedVault</div><div class="step-detail" id="d2">Waiting…</div></div></div>
  </div>
  <button id="deployBtn" onclick="runDeploy()" disabled>Deploy All Contracts</button>
</div>

<div class="card">
  <h2>Log</h2>
  <div class="log" id="log"></div>
</div>

<div class="result-box" id="resultBox">
  <h3>✓ Deployment Complete — copy these into your .env</h3>
  <div class="addr-row"><span class="addr-label">StakingOracle</span><span class="addr-val" id="rOracle">—</span><button class="copy-btn" onclick="cp('rOracle')">copy</button></div>
  <div class="addr-row"><span class="addr-label">PolicyRegistry</span><span class="addr-val" id="rRegistry">—</span><button class="copy-btn" onclick="cp('rRegistry')">copy</button></div>
  <div class="addr-row"><span class="addr-label">GatedVault</span><span class="addr-val" id="rVault">—</span><button class="copy-btn" onclick="cp('rVault')">copy</button></div>
  <div class="env-block" id="envBlock"></div>
</div>

<script src="https://unpkg.com/@polkadot/api@16.5.6/bundle-polkadot-api.js"></script>
<script>
// ── Constants ────────────────────────────────────────────────────────────────
const WS_URL     = 'wss://test-node-v3.portaldot.dev';
const EVM_RELAYER = '0x7AeDB4bb950dFD8E85Bef931A024D43C646f7FBf';
const SALT = '0x' + '00'.repeat(32);

// ── Bytecodes (EVM deployment bytecode, compiled with Hardhat solc 0.8.24) ──
const ORACLE_BYTECODE = '';

const REGISTRY_BYTECODE = '';

const VAULT_BYTECODE = '';

// ── ABI-encode constructor args (no ethers needed — manual ABI encoding) ─────
function encodeAddress(addr) {
  // left-pad 20-byte address to 32 bytes
  return addr.toLowerCase().replace('0x','').padStart(64,'0');
}
function encodeUint256(n) {
  return BigInt(n).toString(16).padStart(64,'0');
}

// ── State ─────────────────────────────────────────────────────────────────────
let api, signer, selectedAddress;
const { ApiPromise, WsProvider } = window.polkadotApi || {};

// ── Logging ───────────────────────────────────────────────────────────────────
function log(msg, cls='') {
  const el = document.getElementById('log');
  const line = document.createElement('div');
  if (cls) line.className = cls;
  line.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
  el.appendChild(line);
  el.scrollTop = el.scrollHeight;
}

// ── Step badges ───────────────────────────────────────────────────────────────
function setBadge(i, state) {
  const b = document.getElementById('b'+i);
  b.className = 'badge ' + state;
  b.textContent = state === 'done' ? '✓' : state === 'error' ? '✗' : state === 'running' ? '…' : (i+1);
}
function setDetail(i, msg, cls='') {
  const d = document.getElementById('d'+i);
  d.textContent = msg;
  d.className = 'step-detail' + (cls ? ' '+cls : '');
}

// ── Connect wallet ────────────────────────────────────────────────────────────
async function connectWallet() {
  document.getElementById('connectBtn').disabled = true;
  log('Connecting to wallet extensions…', 'info');

  // Wait for extensions to inject
  await new Promise(r => setTimeout(r, 500));

  const injected = window.injectedWeb3;
  if (!injected || Object.keys(injected).length === 0) {
    log('No wallet extension found. Install Talisman or Polkadot.js extension.', 'err');
    document.getElementById('connectBtn').disabled = false;
    return;
  }

  const walletName = Object.keys(injected)[0];
  log(`Found wallet: ${walletName}`, 'ok');

  let wallet;
  try {
    wallet = injected[walletName];
    await wallet.enable('Potake Deploy');
  } catch(e) {
    log('Wallet enable failed: ' + e.message, 'err');
    document.getElementById('connectBtn').disabled = false;
    return;
  }

  const accounts = await wallet.accounts.get();
  if (!accounts.length) {
    log('No accounts found in wallet.', 'err');
    document.getElementById('connectBtn').disabled = false;
    return;
  }

  signer = wallet.signer;
  const sel = document.getElementById('accountSelect');
  sel.innerHTML = '';
  accounts.forEach(a => {
    const opt = document.createElement('option');
    opt.value = a.address;
    opt.textContent = `${a.name || 'Account'} — ${a.address}`;
    sel.appendChild(opt);
  });
  selectedAddress = accounts[0].address;
  sel.onchange = () => { selectedAddress = sel.value; };

  log(`Loaded ${accounts.length} account(s). Selected: ${selectedAddress}`, 'ok');

  // Connect to node
  log(`Connecting to ${WS_URL}…`, 'info');
  try {
    const provider = new WsProvider(WS_URL);
    api = await ApiPromise.create({ provider });
    await api.isReady;
    const chain = await api.rpc.system.chain();
    log(`Connected to ${chain} ✓`, 'ok');
    document.getElementById('deployBtn').disabled = false;
    log('Ready to deploy. Click "Deploy All Contracts".', 'ok');
  } catch(e) {
    log('Node connection failed: ' + e.message, 'err');
    document.getElementById('connectBtn').disabled = false;
  }
}

// ── Deploy one contract ───────────────────────────────────────────────────────
async function deployContract(idx, name, bytecode, constructorData) {
  setBadge(idx, 'running');
  setDetail(idx, 'Sending transaction…');
  log(`Deploying ${name}…`, 'info');

  const code = bytecode;
  const data = constructorData || '0x';
  const gasLimit = api.registry.createType('SpWeightsWeightV2Weight', {
    refTime: 10_000_000_000n,
    proofSize: 131072n,
  });

  const tx = api.tx.revive.instantiateWithCode(
    0,          // value
    gasLimit,
    null,       // storageDepositLimit
    code,
    data,
    SALT,
  );

  return new Promise((resolve, reject) => {
    tx.signAndSend(selectedAddress, { signer }, ({ status, events, dispatchError }) => {
      if (dispatchError) {
        let msg = dispatchError.toString();
        if (dispatchError.isModule) {
          try { const e = api.registry.findMetaError(dispatchError.asModule); msg = `${e.section}.${e.name}`; } catch {}
        }
        setBadge(idx, 'error');
        setDetail(idx, 'Error: ' + msg, 'err');
        log(`${name} failed: ${msg}`, 'err');
        reject(new Error(msg));
        return;
      }
      if (status.isInBlock) {
        log(`${name} in block ${status.asInBlock.toHex()}`, 'dim');
        setDetail(idx, 'In block… waiting for finalisation');
      }
      if (status.isFinalized) {
        const blockHash = status.asFinalized.toHex();
        // Extract contract address from revive.Instantiated event
        let address = null;
        for (const { event } of events) {
          if (api.events.revive?.Instantiated?.is(event)) {
            address = event.data.contract.toString();
            break;
          }
        }
        if (!address) {
          // Try to find it from any event with contract field
          for (const { event } of events) {
            const d = event.data.toJSON();
            if (d && d.contract) { address = d.contract; break; }
          }
        }
        if (address) {
          setBadge(idx, 'done');
          setDetail(idx, address, 'addr');
          log(`${name} deployed at ${address}`, 'ok');
          resolve({ address, blockHash });
        } else {
          // Fallback: show block hash
          setBadge(idx, 'done');
          setDetail(idx, `Finalized: ${blockHash} (check explorer for address)`, 'addr');
          log(`${name} finalized. Block: ${blockHash}`, 'warn');
          resolve({ address: null, blockHash });
        }
      }
    }).catch(e => {
      setBadge(idx, 'error');
      setDetail(idx, e.message, 'err');
      log(`${name} tx error: ${e.message}`, 'err');
      reject(e);
    });
  });
}

// ── Main deploy sequence ──────────────────────────────────────────────────────
async function runDeploy() {
  document.getElementById('deployBtn').disabled = true;
  log('=== Starting deployment sequence ===', 'info');

  try {
    // 1. StakingOracle(relayer = EVM_RELAYER)
    const oracleData = '0x' + encodeAddress(EVM_RELAYER);
    const { address: oracleAddr, blockHash: oracleTx } = await deployContract(0, 'StakingOracle', ORACLE_BYTECODE, oracleData);

    // 2. PolicyRegistry(agent = EVM_RELAYER)
    const registryData = '0x' + encodeAddress(EVM_RELAYER);
    const { address: registryAddr, blockHash: registryTx } = await deployContract(1, 'PolicyRegistry', REGISTRY_BYTECODE, registryData);

    // 3. GatedVault(oracle = oracleAddr, minUptimeBps = 9500)
    let vaultData = '0x';
    if (oracleAddr) {
      vaultData = '0x' + encodeAddress(oracleAddr) + encodeUint256(9500);
    } else {
      const manualOracle = prompt('Enter StakingOracle address for GatedVault constructor:');
      if (manualOracle) vaultData = '0x' + encodeAddress(manualOracle) + encodeUint256(9500);
    }
    const { address: vaultAddr, blockHash: vaultTx } = await deployContract(2, 'GatedVault', VAULT_BYTECODE, vaultData);

    // Show results
    log('=== All contracts deployed! ===', 'ok');
    document.getElementById('rOracle').textContent   = oracleAddr   || '(check block ' + oracleTx + ')';
    document.getElementById('rRegistry').textContent = registryAddr || '(check block ' + registryTx + ')';
    document.getElementById('rVault').textContent    = vaultAddr    || '(check block ' + vaultTx + ')';

    document.getElementById('envBlock').textContent =
      `ORACLE_ADDRESS=${oracleAddr || 'TODO'}\nREGISTRY_ADDRESS=${registryAddr || 'TODO'}`;

    document.getElementById('resultBox').style.display = 'block';

  } catch(e) {
    log('Deployment stopped: ' + e.message, 'err');
    document.getElementById('deployBtn').disabled = false;
  }
}

function cp(id) {
  navigator.clipboard.writeText(document.getElementById(id).textContent);
}
</script>
</body>
</html>
